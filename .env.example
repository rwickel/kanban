# Base folder all kanban projects must live in.
# The browser only picks a folder NAME — the server joins it: ROOT + name.
KANBAN_PROJECTS_ROOT=C:\Users\Robert\work
# Docker mapping of the same root (host C:\Users\Robert\work -> /work).
# Used when the board runs in a container; leave empty on plain Windows.
KANBAN_PROJECTS_ROOT_CONTAINER=/work
